{
  "name": "@lthero-big/dropit-cli",
  "version": "0.1.0",
  "description": "Command-line client for dropit, the self-hosted real-time clipboard and file drop (command: dropit)",
  "keywords": [
    "dropit",
    "clipboard",
    "cli",
    "file-transfer",
    "self-hosted",
    "pastebin"
  ],
  "license": "AGPL-3.0-only",
  "author": "lthero-big",
  "homepage": "https://lthero-big.github.io/dropit/start/cli/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lthero-big/dropit.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/lthero-big/dropit/issues"
  },
  "type": "module",
  "bin": {
    "dropit": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "lint": "oxlint .",
    "test": "tsx --test --test-concurrency=1 test/unit.test.ts test/push.test.ts test/e2e.test.ts test/download-paths.test.ts test/chunk.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
