# Local pnpm dev: browser goes through the Vite proxy on 5173.
# Production only reads process env; never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://localhost:5173

# Exact callback URLs: ${APP_ORIGIN}/api/auth/github/callback
# and ${APP_ORIGIN}/api/auth/google/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional and additive. Leave empty: the first sign-in on an empty database is admin.
# Listed, provider-verified emails are also created as admins.
ADMIN_EMAILS=
# Default: repository/data. Image: /data. Persist database and files together.
# DATA_DIR=
# Image sets STATIC_DIR=/app/public; local defaults to apps/web/dist.
STATIC_DIR=

MAX_FILE_BYTES=26214400
USER_QUOTA_BYTES=1073741824
RETENTION_HOURS=168
ROOM_MAX_FILE_BYTES=5242880
ROOM_QUOTA_BYTES=52428800
ROOM_RETENTION_HOURS=24
SESSION_HOURS=168
CLEANUP_INTERVAL_MS=60000
MAX_TEXT_BYTES=65536
MAX_ITEMS=1000
RATE_WINDOW_MS=60000
RATE_GENERAL=240
RATE_AUTH=20
RATE_INVITE=10
RATE_UPLOAD=30
RATE_ROOM=10
# Comma-separated trusted proxy CIDRs/IPs. Empty ignores forwarding headers.
TRUST_PROXY=
