# Copy to .env for local development. Never commit real values.
# Production (docker) reads the process environment and ignores this file.

NODE_ENV=development
HOST=0.0.0.0
PORT=8787

# Public origin, no trailing slash. OAuth callbacks (routes land with the backend):
#   ${APP_URL}/auth/github/callback
#   ${APP_URL}/auth/google/callback
APP_URL=http://localhost:8787

# Required in production. Replace this placeholder.
SESSION_SECRET=change-me

# OAuth. Leave empty until the apps are registered. Read only from the environment.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. These accounts are admins in addition to the first user.
ADMIN_EMAILS=

# Files and the SQLite database. Unset DATA_DIR uses <repository>/data.
# A relative DATA_DIR is resolved from the process working directory.
# DATABASE_PATH overrides the file inside DATA_DIR.
# DATA_DIR=
# DATABASE_PATH=

# Built frontend directory. The image sets this to /app/public.
STATIC_DIR=

# Limits
MAX_UPLOAD_BYTES=104857600
USER_QUOTA_BYTES=1073741824
RETENTION_HOURS=168
GUEST_RETENTION_HOURS=24

# Set to 1 only behind a trusted reverse proxy. Otherwise X-Forwarded-For is ignored.
TRUST_PROXY=0
