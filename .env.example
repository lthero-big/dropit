# dropit settings. Copy to .env:  cp .env.example .env
# Docker reads .env through docker-compose.yml; `pnpm dev` loads it when NODE_ENV is not production.
# Never commit real credentials.

# ───────────────────────── Required ─────────────────────────
# Nothing. An empty .env (or no .env at all) gives a working instance at http://<host>:8787.

# ───────────────────── Recommended ──────────────────────────
# The address people type into the browser: scheme + host (+ port), no path.
# Pins CSRF checks and every generated link (OAuth callback, invite/share links, /device).
# Empty = use the address of each request (fine for a quick start / LAN).
# 后台可改: 管理 → 站点地址 (a value saved there wins over this one).
# With https://… the login cookie is Secure (__Host-) and HSTS is sent in production.
APP_ORIGIN=
# Locked out after saving a wrong 站点地址? Start once with RESET_APP_ORIGIN=1, then remove it.
# RESET_APP_ORIGIN=

# ───────────────────────── Optional ─────────────────────────
# Sign-in. Either fill these, or leave them empty and configure in 管理 → OAuth 登录 (后台可改).
# Callback URLs (also shown in 管理 → 站点地址):
#   <APP_ORIGIN>/api/auth/github/callback   <APP_ORIGIN>/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First admin without the browser (optional). Both must be set; only used while the
# database has no account at all, then ignored (changing them later does nothing).
# Without them: `docker logs dropit` prints `dropit setup code: XXXX-XXXX` — open /setup.
# Remove ADMIN_PASSWORD from .env after the first start.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# OAuth only. Leave empty: the first sign-in on an empty database becomes admin.
# Listed, provider-verified emails are also created as admins.
ADMIN_EMAILS=

# Behind a reverse proxy (nginx, Caddy, Traefik…): comma-separated proxy IPs/CIDRs whose
# X-Forwarded-For/-Proto/-Host are trusted, e.g. loopback,172.17.0.1. Empty ignores them.
TRUST_PROXY=

# New-version check (管理 → 更新). Set false on offline hosts.
# UPDATE_CHECK=true
# UPDATE_CHECK_HOURS=12

# Limits — defaults shown. 后台可改: 管理 → 限制 (saved values win over these).
# MAX_FILE_BYTES=26214400
# USER_QUOTA_BYTES=1073741824
# RETENTION_HOURS=168
# ROOM_MAX_FILE_BYTES=5242880
# ROOM_QUOTA_BYTES=52428800
# ROOM_RETENTION_HOURS=24
# MAX_TEXT_BYTES=65536
# MAX_ITEMS=1000
# SESSION_HOURS=168
# RATE_WINDOW_MS=60000
# RATE_GENERAL=240
# RATE_AUTH=20
# RATE_INVITE=10
# RATE_UPLOAD=30
# RATE_ROOM=10
# UPLOAD_CHUNK_BYTES=8388608
# UPLOAD_CHUNK_TIMEOUT_MS=120000
# UPLOAD_CHUNKS_PER_SESSION=3
# UPLOAD_CHUNKS_PER_USER=6
# UPLOAD_CHUNKS_GLOBAL=16
# UPLOAD_SESSIONS_PER_USER=8
# UPLOAD_SESSIONS_GLOBAL=128
# RATE_CHUNK=2000
# Only via env (not in 管理 → 限制):
# CLEANUP_INTERVAL_MS=60000
# RATE_TOKEN=120

# ──────────────── Rarely needed / set by the image ──────────
# The Docker image already sets NODE_ENV=production, PORT=8787, HOST=0.0.0.0,
# DATA_DIR=/data and STATIC_DIR=/app/public.
# Local `pnpm dev` (no Docker): uncomment these. Leave APP_ORIGIN empty or set http://localhost:5173.
# NODE_ENV=development
# HOST=127.0.0.1
# PORT=8787
# DATA_DIR=          (default: <repo>/data)
# STATIC_DIR=        (default: apps/web/dist)
